{
  "name": "spk-monorepo",
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "build:spk": "pnpm --filter spk-core build && pnpm --filter spk build",
    "dev": "pnpm --filter spk-web dev",
    "dev:web": "pnpm --filter spk-web dev",
    "preview": "pnpm --filter spk-web preview",
    "spklang": "node packages/spklang/dist/cli.js"
  },
  "devDependencies": {
    "typescript": "^5.3.0"
  },
  "engines": {
    "node": ">=18"
  }
}
